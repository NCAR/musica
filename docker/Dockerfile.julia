# Builds MUSICA with the Julia interface and TUV-x, then runs the Julia tests.
#
# This mirrors what .github/workflows/julia.yml does, so `docker build`
# reproduces Julia and TUV-x breakage locally rather than through a CI run.
# Build against a specific Julia release with:
#
#   docker build -f docker/Dockerfile.julia --build-arg JULIA_VERSION=1.12 -t musica-julia .
ARG JULIA_VERSION=1.11
FROM julia:${JULIA_VERSION} AS julia-base

FROM fedora:41

ARG BUILD_TYPE=Release

RUN dnf -y update \
    && dnf -y install \
        blas-devel \
        cmake \
        curl \
        gcc-c++ \
        gcc-gfortran \
        git \
        hdf5-devel \
        lapack-devel \
        libcurl-devel \
        m4 \
        make \
        netcdf-devel \
        netcdf-fortran-devel \
        pkgconf-pkg-config \
        zlib-devel \
    && dnf clean all

# Copy Julia from the official image
ENV JULIA_PATH=/usr/local/julia
ENV PATH=${JULIA_PATH}/bin:${PATH}
# Clone the General registry over git instead of pulling content-hash snapshots
# from the Pkg server, which intermittently 404s in container builds.
ENV JULIA_PKG_SERVER=""
COPY --from=julia-base ${JULIA_PATH} ${JULIA_PATH}

COPY . musica

RUN cd musica \
    && JLCXX_PREFIX=$(julia -e 'import Pkg; Pkg.add("CxxWrap"); using CxxWrap; print(CxxWrap.prefix_path())') \
    && cmake -S . \
             -B build \
             -D CMAKE_PREFIX_PATH=$JLCXX_PREFIX \
             -D CMAKE_BUILD_TYPE=${BUILD_TYPE} \
             -D MUSICA_ENABLE_JULIA=ON \
             -D MUSICA_ENABLE_MICM=ON \
             -D MUSICA_ENABLE_TUVX=ON \
             -D MUSICA_ENABLE_CARMA=OFF \
             -D MUSICA_ENABLE_TESTS=OFF \
             -D MUSICA_BUILD_SHARED_LIBS=ON \
             -D MUSICA_USE_FMT=OFF \
             -D MUSICA_ENABLE_INSTALL=ON \
    && cmake --build build -j$(nproc)

# Set library path and precompile Julia package
RUN cd musica/julia \
    && julia --project=. -e 'using Pkg; Pkg.develop(PackageSpec(path="../etc/Musica_jll")); Pkg.instantiate()'

WORKDIR /musica

CMD ["julia", "--project=julia", "julia/test/runtests.jl"]
