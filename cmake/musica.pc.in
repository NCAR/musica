prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@MUSICA_INSTALL_INCLUDE_DIR@

yaml_lib=yaml-cpp
@IS_DEBUG@yaml_lib=yaml-cppd

Name: musica
Description: MUSICA library for modeling atmospheric chemistry
Version: @musica_VERSION@
Cflags: -I${includedir}
Libs: -L${libdir} -lmusica@MUSICA_PC_MIEM_LIBS@ -lmechanism_configuration -l${yaml_lib}@MUSICA_PC_CXX_RUNTIME@
@MUSICA_PC_LIBS_PRIVATE@