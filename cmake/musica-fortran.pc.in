prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@MUSICA_INSTALL_INCLUDE_DIR@/musica/fortran

yaml_lib=yaml-cpp
@IS_DEBUG@yaml_lib=yaml-cppd
source_revision=@MUSICA_SOURCE_REVISION@
micm_revision=@MUSICA_MICM_REVISION@
miem_revision=@MUSICA_MIEM_REVISION@
mechanism_configuration_revision=@MUSICA_MECH_CONFIG_REVISION@
tuvx_revision=@MUSICA_TUVX_REVISION@
miem_enabled=@MUSICA_ENABLE_MIEM@
tuvx_enabled=@MUSICA_ENABLE_TUVX@
fmt_enabled=@MUSICA_USE_FMT@
fortran_compiler=@CMAKE_Fortran_COMPILER@
fortran_compiler_id=@CMAKE_Fortran_COMPILER_ID@
fortran_compiler_version=@CMAKE_Fortran_COMPILER_VERSION@

Name: musica-fortran
Description: Fortran wrapper for the MUSICA library for modeling atmospheric chemistry
Version: @musica_VERSION@
Requires: @MUSICA_FORTRAN_PKGCONFIG_REQUIRES@
Cflags: -I${includedir}
Libs: -L${libdir} -lmusica-fortran -lmusica @MUSICA_FORTRAN_COMPONENT_LIBS@ -lmechanism_configuration -l${yaml_lib} @MUSICA_FORTRAN_OPTIONAL_LIBS@ @MUSICA_FORTRAN_NETCDF_LIBS@ @MUSICA_FORTRAN_CXX_RUNTIME_LIBS@
